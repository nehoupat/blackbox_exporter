# Image of the nehoupat fork: the upstream busybox runtime base, built without promu.
FROM --platform=$BUILDPLATFORM golang:1.27.4 AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG REVISION=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -o /out/blackbox_exporter -ldflags "\
      -X github.com/prometheus/common/version.Version=${VERSION} \
      -X github.com/prometheus/common/version.Revision=${REVISION} \
      -X github.com/prometheus/common/version.Branch=origin \
      -X github.com/prometheus/common/version.BuildUser=nehoupat \
      -X github.com/prometheus/common/version.BuildDate=$(date -u +%Y%m%d-%H:%M:%S)" .

FROM quay.io/prometheus/busybox-linux-${TARGETARCH}:latest
LABEL org.opencontainers.image.source="https://github.com/nehoupat/blackbox_exporter"
LABEL org.opencontainers.image.description="blackbox_exporter fork with cache busting and a response hook"
LABEL org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /out/blackbox_exporter /bin/blackbox_exporter
COPY blackbox.yml /etc/blackbox_exporter/config.yml
EXPOSE 9115
ENTRYPOINT ["/bin/blackbox_exporter"]
CMD ["--config.file=/etc/blackbox_exporter/config.yml"]
